<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting settings for the Nurse Station app.

  Going live = change Legacy__BaseUrl (the server that hosts the legacy suite and the EMR apps) and set Legacy__SsoSecret.
  Every legacy / EMR address is derived from the base URL:
      {BaseUrl}/CLIENTR2/            legacy ASP.NET pages, Dashboard (Exit), Login, header images
      {BaseUrl}/CWWEBMVC/            legacy MVC pages
      {BaseUrl}/EMR_App              Daily Flow Sheet, Nurse Care Plan
      {BaseUrl}/EMR_AppV2            Daily Flow Sheet - New, Nurse Care Plan - New, Pre-Operative Checklist
  If a site folder is named differently on live, set Legacy__AppSite / Legacy__MvcSite / Legacy__EmrSite / Legacy__EmrV2Site.
  Any single address can still be forced with its own key (for example Legacy__EmrV2Path).
  "__" in a name is the same as ":" in appsettings.json. Recycle the application pool after editing.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\NurseStationRazor.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <!-- Production turns off the development auto-login. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

          <!-- The server that hosts the legacy suite and the EMR apps. -->
          <environmentVariable name="Legacy__BaseUrl" value="http://172.16.50.125:88" />

          <!-- Optional. The EMR modules sign the user in with a link the legacy Nurse Station page issues, so this can stay blank.
               Fill it (same secret the legacy suite signs with) only to sign the link here instead, which skips that legacy call. -->
          <environmentVariable name="Legacy__SsoSecret" value="" />

          <!-- Database connection (optional override). -->
          <!-- <environmentVariable name="ConnectionStrings__CareWorks" value="Server=...;Database=...;User ID=...;Password=...;TrustServerCertificate=True" /> -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
